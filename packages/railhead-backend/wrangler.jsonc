// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "railhead",
  "main": ".wrangler/validate/src/server.ts",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "Repo"
      },
      {
        "name": "OWNER",
        "class_name": "Owner"
      }
    ]
  },
  "vars": {
    "RELYING_PARTY_HOST": "railhead.mashin.workers.dev"
  },
  "secrets": {
    "required": [
      "OWNER_BOOTSTRAP_TOKEN",
      "SESSION_SIGNING_SECRET"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/agent/*",
      "/git/*"
    ],
    "directory": "../railhead-frontend/dist"
  },
  "exports": {
    "Repo": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Owner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  }
}
