// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "railhead",
  "main": ".wrangler/validate/src/server.ts",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "railhead-check-backups"
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "railhead"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "Repo"
      },
      {
        "name": "SANDBOX",
        "class_name": "RailheadSandbox"
      },
      {
        "name": "OWNER",
        "class_name": "Owner"
      }
    ]
  },
  "workflows": [
    {
      "binding": "CHECKS",
      "name": "railhead-checks",
      "class_name": "CheckWorkflow",
      "script_name": "railhead"
    }
  ],
  "vars": {
    "ARTIFACTS_NAMESPACE": "railhead",
    "BACKUP_BUCKET_NAME": "railhead-check-backups",
    "RELYING_PARTY_HOST": "railhead.mashin.workers.dev"
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_ACCOUNT_ID",
      "OWNER_BOOTSTRAP_TOKEN",
      "SESSION_SIGNING_SECRET"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/agent/*",
      "/git/*"
    ],
    "directory": "../railhead-frontend/dist"
  },
  "exports": {
    "Repo": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RailheadSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "railhead-sandbox"
    },
    "Owner": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CheckWorkflow": {
      "type": "workflow",
      "name": "railhead-checks"
    }
  },
  "containers": [
    {
      "name": "railhead-sandbox",
      "image": "../../containers/railhead/Dockerfile",
      "max_instances": 10,
      "instance_type": "basic"
    }
  ],
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  }
}
