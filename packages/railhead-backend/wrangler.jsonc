// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "railhead",
  "main": ".wrangler/validate/src/server.ts",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "directory": "../railhead-frontend/dist"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  }
}
